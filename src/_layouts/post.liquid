---
layout: default.liquid
permalink: "/projetos/{{page.fileSlug}}/"
css: post.css
---
{% assign previousPost = collections.post | getPreviousCollectionItem %}
{% assign src = image | append: "-Banner.png" %}
<main id="main">
	<div class="hero__bg"></div>
	<article
		class="post"
		itemscope
		itemtype="http://schema.org/BlogPosting"
	>
		<div class="post__header">
			<h1 class="post__title" itemprop="name headline">
				{{ title | escape }}
			</h1>
			<div class="post__info">
				<div class="post__info__container">
					<p class="post__info__title">Minha Função</p>
					{% for role in roles %}
						<p class="post__info__text">{{ role }}</p>
					{% endfor %}
				</div>
				{%- if showteam == true -%}
					<div class="post__info__container">
						<h3 class="post__info__title">Equipe</h3>
						{% for person in team %}
							{%- assign portfolio = person.portfolio -%}
							<p class="post__info__text">
							{%- if portfolio -%}
								<a href="{{ portfolio }}" target="_blank"
								rel="noopener noreferrer">
									{{ person.name }}
								</a>
							{%- else -%}
								{{ person.name }}
							{%- endif -%}, {{ person.role }}
							</p>
						{% endfor %}
					</div>
				{%- endif -%}
				<div class="post__info__container">
					<h3 class="post__info__title">Data</h3>
					<p class="post__info__text">{{ page.date | date: "%Y" }}</p>
				</div>
			</div>
			{% image src, "", "banner", priority %}
		</div>
		<div class="post__content" itemprop="articleBody">
			{{ content }}
		</div>
	</article>
	<section class="postnav">
		<div class="postnav__content">
			{% if previousPost %}
				<a href="{{ previousPost.url }}" class="postnav__link"
				rel="next">
					Próximo projeto
					<br>
					<span class="postnav__title">
						{{ previousPost.data.title }}
					</span>
    			</a>
    		{%- else -%}
				<a href="{{ "/" | url }}" class="postnav__link">
					Sem mais projetos →
					<br>
					<span class="postnav__title">Voltar para a home</span>
				</a>
    		{% endif %}
		</div>
	</section>
</main>
