---
layout: default.liquid
css: home.css
---
<div class="container">
	{% include "hero" %}
	<main id="main">
		<section class="projetos" id="projetos">
			{%- for post in collections.post reversed -%}
				{% assign src = post.data.image | append: "-Card.png" %}
				<a href="{{ post.url | url }}" class="card noise">
					{% image src, "", "card" %}
					<div class="card__description">
						<h2 class="card__title">
							{{ post.data.title | escape }}
						</h2>
						<span class="card__tag">
							{{ post.data.categories | join: " • " }}
						</span>
					</div>
				</a>
			{%- endfor -%}
		</section>
	</main>
	{% include "contact" %}
</div>
