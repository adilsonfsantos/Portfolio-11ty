{
	"name": "portfolio-11ty",
	"version": "1.0.0",
	"description": "Portfolio of Adilson Santos using 11ty",
	"main": ".eleventy.js",
	"type": "module",
	"scripts": {
		"build": "npx @11ty/eleventy --incremental --quiet",
		"dev": "npx @11ty/eleventy --incremental --serve",
		"eslint": "eslint . --cache --cache-location .cache/eslint",
		"eslint:fix": "eslint . --fix --cache --cache-location .cache/eslint",
		"stylelint": "stylelint 'src/**/*.{css,scss}' --cache --cache-location .cache/stylelint",
		"stylelint:fix": "stylelint --fix 'src/**/*.{css,scss}' --cache --cache-location .cache/stylelint",
		"format": "prettier --check . --cache --cache-location .cache/prettier",
		"format:fix": "prettier --write . --cache --cache-location .cache/prettier"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adilsonfsantos/Portfolio-11ty.git"
	},
	"author": "Adilson Santos",
	"keywords": [
		"11ty",
		"Eleventy"
	],
	"license": "GPL-3.0-or-later",
	"bugs": {
		"url": "https://github.com/adilsonfsantos/Portfolio-11ty/issues"
	},
	"homepage": "https://github.com/adilsonfsantos/Portfolio-11ty#readme",
	"browserslist": [
		"defaults"
	],
	"dependencies": {
		"@11ty/eleventy": "^3.1.7",
		"@11ty/eleventy-img": "^7.1.1",
		"@11ty/eleventy-plugin-directory-output": "^1.0.2",
		"@11tyrocks/eleventy-plugin-sass-lightningcss": "^1.3.0",
		"eleventy-xml-plugin": "^0.1.0",
		"html-minifier-terser": "^7.2.0",
		"markdown-it": "^15.0.3",
		"markdown-it-attrs": "^5.0.1",
		"markdown-it-link-attributes": "^4.0.1",
		"require-dir": "^1.2.0",
		"sass": "^1.106.1",
		"slugify": "^1.6.9"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"prettier": "3.9.10",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-scss": "^7.3.0"
	}
}
